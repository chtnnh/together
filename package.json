{
  "name": "together",
  "version": "0.3.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:realtime": "pnpm --filter @together/realtime run build",
    "deploy:realtime": "pnpm --filter @together/realtime exec wrangler deploy --env production",
    "dev": "turbo run dev",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "prepare": "husky",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:quality": "biome check --error-on-warnings . && pnpm typecheck",
    "ci:build": "bash scripts/ci-build.sh",
    "ci:unit": "vitest run",
    "ci:e2e": "pnpm --filter @together/web test:install && pnpm --filter @together/web test",
    "ci:visual": "pnpm --filter @together/web test:install && bash apps/web/scripts/visual-regression-linux.sh test",
    "ci:db": "bash scripts/ci-db-guard.sh",
    "ci:pre-commit": "bash scripts/ci-pre-commit.sh",
    "ci:pre-push": "bash scripts/ci-pre-push.sh",
    "db:generate": "pnpm --filter @together/db generate",
    "db:migrate": "pnpm --filter @together/db migrate"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@vitejs/plugin-react": "^4.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "turbo": "^2.10.1",
    "typescript": "^5.8.3",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "engines": {
    "node": ">=22"
  }
}
